# These are the SDKs that are used by all configurations
Imports:
- ../../../carbon/src/core_project/core_project.yaml
- ../../../carbon/src/BlueExposure/uses_BlueExposureStatic.yaml

# Settings from the General section, for all configurations
General:
  ConfigurationType: DynamicLibrary
  UseOfMfc: false
  IntDir: ..\..\autobuild\temp\$(ProjectName)\$(Platform)\$(Configuration)\
  TargetExt: .pyd

ClCompile:
  WarningLevel: Level3
  TreatWarningAsError: true
  BufferSecurityCheck: false
  AdditionalIncludeDirectories:
  - .
  - ../../../../../../sdk/
  PrecompiledHeader: Use
  PrecompiledHeaderFile: stdafx.h
  PrecompiledHeaderOutputFile: $(IntDir)$(TargetName).pch

Link:
  GenerateDebugInformation: true
  ProgramDatabaseFile: $(TargetDir)$(TargetName).pdb

Configurations:
  Release_27|Win32,x64:
    Imports:
    - ../../../../../../sdk/Python/ccpproj/Python_2.7.yaml
    General:
      OutDir: ..\..\autobuild\pyFSD\python_27\$(Platform)\
      TargetName: pyFSD
      TargetExt: .pyd

  Debug|Win32,x64:
    Imports:
    - ../../../carbon/src/stackless/stackless.yaml
    General:
      OutDir: ..\..\autobuild\pyFSD\exefile\$(Platform)\
      TargetName: pyFSD_d
      LinkIncremental: true
    ClCompile:
      PreprocessorDefinitions:
      - _DEBUG
      Optimization: Disabled
      RuntimeLibrary: MultiThreadedDebugDLL
      DebugInformationFormat: EditAndContinue
    Link:
      AdditionalDependencies:
      - msvcrtd.lib
      - msvcprtd.lib
      - atlsd.lib

  Release|Win32,x64:
    Imports:
    - ../../../carbon/src/stackless/stackless.yaml
    General:
      OutDir: ..\..\autobuild\pyFSD\exefile\$(Platform)\
      TargetName: pyFSD
